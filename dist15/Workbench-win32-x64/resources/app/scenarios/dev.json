{
  "id": "dev",
  "name": "开发",
  "resetOnStart": false,
  "grid": {
    "cols": 12,
    "rows": 10,
    "gap": 6
  },
  "engine": {
    "cmd": "dsh",
    "args": [
      "web",
      "--no-open",
      "--port",
      "0"
    ],
    "home": "C:\\Users\\aa\\.dsh",
    "cwd": "D:\\deepseek\\电脑",
    "timeoutMs": 60000
  },
  "vscode": {
    "mode": "code-server",
    "cmd": "vendor/cs/code-server-4.145.2-windows-amd64/lib/node.exe",
    "args": [
      "vendor/cs/code-server-4.145.2-windows-amd64",
      "--bind-addr",
      "127.0.0.1:{port}",
      "--auth",
      "none",
      "--disable-telemetry",
      "--disable-update-check",
      "--disable-workspace-trust",
      "--user-data-dir",
      "runtime/code-server-data"
    ],
    "port": 9123,
    "timeoutMs": 90000,
    "folder": "D:/deepseek/电脑"
  },
  "notes": {
    "root": "E:/Obsidian/note"
  },
  "windows": [
    {
      "type": "monitor",
      "title": "电脑监控"
    },
    {
      "type": "preview",
      "title": "文件预览器"
    },
    {
      "type": "file",
      "title": "文件浏览器"
    },
    {
      "type": "note",
      "title": "笔记"
    },
    {
      "type": "web",
      "title": "DSH"
    },
    {
      "type": "vscode",
      "title": "VSCode"
    }
  ],
  "panels": [
    {
      "id": "monitor",
      "type": "monitor",
      "title": "电脑监控"
    },
    {
      "id": "preview",
      "type": "preview",
      "title": "文件预览器"
    },
    {
      "id": "files",
      "type": "file",
      "title": "文件浏览器",
      "root": "roots"
    },
    {
      "id": "dsh",
      "type": "web",
      "title": "DSH",
      "embed": "engine"
    },
    {
      "id": "editor",
      "type": "vscode",
      "title": "VSCode",
      "fallbackUrl": "http://127.0.0.1:9123"
    },
    {
      "id": "notes",
      "type": "note",
      "title": "笔记",
      "root": "E:/Obsidian/note"
    }
  ],
  "layout": {
    "mode": "grid",
    "cells": [
      [
        "monitor",
        "preview",
        "files"
      ],
      [
        "",
        "dsh",
        "dsh"
      ]
    ]
  },
  "launchers": [
    {
      "key": "vscode-desktop",
      "label": "VSCode（桌面版）",
      "note": "重活、调试、扩展齐全时用这个",
      "path": "D:\\VUE\\Code\\Microsoft VS Code\\Code.exe"
    },
    {
      "key": "pycharm",
      "label": "PyCharm",
      "note": "PyCharm Community 2024.2.1",
      "path": "D:\\Python\\pycharm\\python\\PyCharm Community Edition 2024.2.1\\bin\\pycharm64.exe"
    },
    {
      "key": "deveco",
      "label": "DevEco Studio",
      "note": "HarmonyOS 开发",
      "path": "D:\\Deveco studio\\zhu\\DevEco Studio\\bin\\devecostudio64.exe"
    },
    {
      "key": "vmware",
      "label": "VMware Workstation",
      "note": "虚拟机（第二版改成 vmrun 起停）",
      "path": "D:\\Linux\\vmware.exe"
    },
    {
      "key": "obsidian",
      "label": "Obsidian",
      "note": "笔记库在 E:\\Obsidian",
      "path": "E:\\Obsidian\\Obsidian.exe"
    },
    {
      "key": "explorer-python",
      "label": "打开 Python 目录",
      "note": "D:\\Python\\pycharm",
      "path": "C:\\Windows\\explorer.exe",
      "args": [
        "D:\\Python\\pycharm"
      ]
    }
  ],
  "taskbar": [
    {
      "key": "pycharm",
      "label": "PyCharm",
      "note": "单独窗口打开"
    },
    {
      "key": "deveco",
      "label": "DevEco Studio",
      "note": "单独窗口打开"
    },
    {
      "key": "vscode-desktop",
      "label": "VSCode（桌面版）",
      "note": "单独窗口打开"
    },
    {
      "key": "obsidian",
      "label": "Obsidian",
      "note": "单独窗口打开"
    },
    {
      "key": "vmware",
      "label": "VMware",
      "note": "虚拟机不进面板，单独窗口"
    },
    {
      "key": "explorer-python",
      "label": "资源管理器",
      "note": "单独窗口"
    }
  ]
}